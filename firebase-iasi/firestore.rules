rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function staff() {
      return signedIn()
        && request.auth.token.role in ['admin', 'operator']
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == request.auth.token.role;
    }
    function notificationOwner(uid) {
      return owner(uid) && (request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous' || request.auth.token.get('customerSession', false) == true || staff());
    }
    function bounded(max) { return request.query.limit != null && request.query.limit <= max; }
    match /publicConfig/{id} { allow get: if id == 'booking'; }
    match /users/{uid} {
      allow get: if owner(uid) || staff();
      allow list: if staff() && bounded(50);
      match /meta/{id} { allow get: if id == 'notifications' ? notificationOwner(uid) : owner(uid); }
      match /notifications/{id} { allow get: if notificationOwner(uid); allow list: if notificationOwner(uid) && bounded(20); }
    }
    match /staffAccess/{uid} { allow get: if owner(uid); }
    match /bookings/{id} {
      allow get: if staff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if bounded(50) && (staff() || (signedIn() && resource.data.ownerUid == request.auth.uid));
      match /audit/{event} { allow get: if staff(); allow list: if staff() && bounded(20); }
    }
    match /customers/{id} { allow get: if staff(); allow list: if staff() && bounded(50); }
    match /movements/{id} { allow get: if staff(); allow list: if staff() && bounded(100); }
    match /dailyStats/{id} { allow get: if staff(); }
    match /liveStats/{id} { allow get: if staff(); }
    // Financial data, identity keys, jobs and every client write remain denied.
    match /{document=**} { allow read, write: if false; }
  }
}
